# Copy this file to .env and fill in real values. Never commit the real .env file.
#
# This suite tests the User Registration module (Administration -> Users) of the
# Eyefinity Encompass admin portal. See "User Registration Module - Use Cases by Role"
# for the full use-case source this project automates.

# ---------------------------------------------------------------------------
# Application under test
# ---------------------------------------------------------------------------
BASE_URL=https://connect-st-admin.icarebuddy.com

# ---------------------------------------------------------------------------
# Role credentials
# One active test login is required per role (see "Preconditions and test data"
# in the use-case doc). Company Key is the field shown on the login form above
# Email/Password; leave blank if your login doesn't need it.
#
# IMPORTANT: the login page is protected by a visible Google reCAPTCHA v2
# checkbox. This suite does not solve or bypass it. Instead, run
#   npm run auth:setup
# once per role: it opens a real browser window, you sign in by hand (solving
# the reCAPTCHA yourself), and the resulting session is saved under auth/ for
# every automated test to reuse. See README.md "Authentication & reCAPTCHA".
# ---------------------------------------------------------------------------

# SysAdmin - master company (Eyefinity Navigator)
SYSADMIN_COMPANY_KEY=
SYSADMIN_EMAIL=
SYSADMIN_PASSWORD=

# AppAdmin - master company (Eyefinity Navigator)
APPADMIN_COMPANY_KEY=
APPADMIN_EMAIL=
APPADMIN_PASSWORD=

# Admin - client company ("937 new company")
ADMIN_COMPANY_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Employee - client company ("937 new company")
EMPLOYEE_COMPANY_KEY=
EMPLOYEE_EMAIL=
EMPLOYEE_PASSWORD=

# ---------------------------------------------------------------------------
# Test data (from "Preconditions and test data" in the use-case doc)
# Override these if your environment uses different company/store names.
# ---------------------------------------------------------------------------
MASTER_COMPANY_NAME=Eyefinity Navigator
CLIENT_COMPANY_NAME=937 new company
CLIENT_COMPANY_NAME_2=Eyefinity 969
CLIENT_COMPANY_NAME_3=QA 0009
CLIENT_COMPANY_NAME_4=917company

HOME_STORE_1=937-2
HOME_STORE_2=937-29
HOME_STORE_3=937-4
HOME_STORE_DEFAULT=Default store

# An existing, already-registered email in the environment, used for
# duplicate-email checks (SA-09/AA-10/AD-10) and the "other company's user is
# hidden" check (AD-07). Tests that need it are skipped if this is blank.
EXISTING_USER_EMAIL=

# An existing, already-registered SysAdmin email, used to confirm SysAdmin
# users are protected from edit/reset/delete by lower roles (AA-07).
# Tests that need it are skipped if this is blank.
EXISTING_SYSADMIN_EMAIL=

# ---------------------------------------------------------------------------
# Safety switch for destructive/irreversible test cases
# Some use cases (EM-04 change-own-password, CR-06 account lockout) change
# real account state or repeatedly submit wrong passwords. They are skipped
# unless you explicitly opt in.
# ---------------------------------------------------------------------------
ALLOW_DESTRUCTIVE_TESTS=false
